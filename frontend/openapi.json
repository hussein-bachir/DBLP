{
  "openapi": "3.1.0",
  "info": {
    "title": "DBLP dashboard API",
    "description": "Search researchers in the DBLP dump and read their publication profiles. Read-only.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/status": {
      "get": {
        "summary": "Status",
        "description": "Whether the index is built, and how big it is.",
        "operationId": "status_api_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "get": {
        "summary": "Search",
        "description": "Find researchers by name: accent-insensitive substring match, then close spellings.",
        "operationId": "search_api_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 500,
              "description": "Any part of a name, in any word order",
              "default": "",
              "title": "Q"
            },
            "description": "Any part of a name, in any word order"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/author": {
      "get": {
        "summary": "Author",
        "description": "A researcher's profile: totals, papers per year, venues, co-authors and newest papers.",
        "operationId": "author_api_author_get",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/papers": {
      "get": {
        "summary": "Papers",
        "description": "A page of a researcher's papers, newest first.",
        "operationId": "papers_api_papers_get",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Id"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PapersPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/ask/status": {
      "get": {
        "summary": "Ask Status",
        "description": "Which retrieval indexes exist and which language-model providers are usable now.",
        "operationId": "ask_status_api_ask_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/ask": {
      "post": {
        "summary": "Ask",
        "description": "Answer a question about the dataset, streamed as server-sent events.\n\nA language model calls fixed search/count tools over the index (it never writes SQL) and\ncites the papers it used as [P1], [P2], ...",
        "operationId": "ask_api_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A text/event-stream: each `data:` line is one AskEvent as JSON, ending with a done or error event.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/AskEvent",
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskDoneEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "done",
            "title": "Type"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourcePaper"
            },
            "type": "array",
            "title": "Sources"
          },
          "authors": {
            "items": {
              "$ref": "#/components/schemas/AuthorRef"
            },
            "type": "array",
            "title": "Authors"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "tool_calls": {
            "type": "integer",
            "title": "Tool Calls"
          }
        },
        "type": "object",
        "required": [
          "type",
          "sources",
          "authors",
          "provider",
          "model",
          "tool_calls"
        ],
        "title": "AskDoneEvent"
      },
      "AskErrorEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "error",
            "title": "Type"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "type",
          "message"
        ],
        "title": "AskErrorEvent"
      },
      "AskEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AskStatusEvent"
          },
          {
            "$ref": "#/components/schemas/AskTokenEvent"
          },
          {
            "$ref": "#/components/schemas/AskRetractEvent"
          },
          {
            "$ref": "#/components/schemas/AskDoneEvent"
          },
          {
            "$ref": "#/components/schemas/AskErrorEvent"
          }
        ],
        "title": "AskEvent",
        "description": "One server-sent event of POST /api/ask (each `data:` line is one of these, as JSON).",
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "done": "#/components/schemas/AskDoneEvent",
            "error": "#/components/schemas/AskErrorEvent",
            "retract": "#/components/schemas/AskRetractEvent",
            "status": "#/components/schemas/AskStatusEvent",
            "token": "#/components/schemas/AskTokenEvent"
          }
        }
      },
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider",
            "description": "a provider id from /api/ask/status"
          },
          "model": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Model",
            "description": "any model name the provider accepts"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "AskRetractEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "retract",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "AskRetractEvent"
      },
      "AskStatus": {
        "properties": {
          "keyword_search": {
            "type": "boolean",
            "title": "Keyword Search"
          },
          "semantic_search": {
            "type": "boolean",
            "title": "Semantic Search"
          },
          "semantic_papers": {
            "type": "integer",
            "title": "Semantic Papers"
          },
          "semantic_min_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Semantic Min Year"
          },
          "semantic_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Semantic Error"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/LLMProvider"
            },
            "type": "array",
            "title": "Providers"
          },
          "default_provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Provider"
          }
        },
        "type": "object",
        "required": [
          "keyword_search",
          "semantic_search",
          "semantic_papers",
          "semantic_min_year",
          "semantic_error",
          "providers",
          "default_provider"
        ],
        "title": "AskStatus"
      },
      "AskStatusEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "status",
            "title": "Type"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "type",
          "text"
        ],
        "title": "AskStatusEvent"
      },
      "AskTokenEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "token",
            "title": "Type"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "type",
          "text"
        ],
        "title": "AskTokenEvent"
      },
      "AuthorRef": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "AuthorRef"
      },
      "CoAuthor": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "shared": {
            "type": "integer",
            "title": "Shared"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "shared"
        ],
        "title": "CoAuthor"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LLMProvider": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "default_model": {
            "type": "string",
            "title": "Default Model"
          },
          "models": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Models"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "default_model",
          "models"
        ],
        "title": "LLMProvider"
      },
      "Paper": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "type": {
            "type": "string",
            "enum": [
              "article",
              "inproceedings"
            ],
            "title": "Type"
          },
          "venue": {
            "type": "string",
            "title": "Venue"
          }
        },
        "type": "object",
        "required": [
          "key",
          "title",
          "year",
          "type",
          "venue"
        ],
        "title": "Paper"
      },
      "PapersPage": {
        "properties": {
          "papers": {
            "items": {
              "$ref": "#/components/schemas/Paper"
            },
            "type": "array",
            "title": "Papers"
          }
        },
        "type": "object",
        "required": [
          "papers"
        ],
        "title": "PapersPage"
      },
      "Profile": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "n_papers": {
            "type": "integer",
            "title": "N Papers"
          },
          "first_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Year"
          },
          "last_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Year"
          },
          "n_articles": {
            "type": "integer",
            "title": "N Articles"
          },
          "n_inproceedings": {
            "type": "integer",
            "title": "N Inproceedings"
          },
          "n_coauthors": {
            "type": "integer",
            "title": "N Coauthors"
          },
          "n_venues": {
            "type": "integer",
            "title": "N Venues"
          },
          "per_year": {
            "items": {
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "title": "Per Year"
          },
          "venues": {
            "items": {
              "$ref": "#/components/schemas/VenueCount"
            },
            "type": "array",
            "title": "Venues"
          },
          "coauthors": {
            "items": {
              "$ref": "#/components/schemas/CoAuthor"
            },
            "type": "array",
            "title": "Coauthors"
          },
          "papers": {
            "items": {
              "$ref": "#/components/schemas/Paper"
            },
            "type": "array",
            "title": "Papers"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "n_papers",
          "first_year",
          "last_year",
          "n_articles",
          "n_inproceedings",
          "n_coauthors",
          "n_venues",
          "per_year",
          "venues",
          "coauthors",
          "papers"
        ],
        "title": "Profile"
      },
      "SearchResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            },
            "type": "array",
            "title": "Results"
          },
          "corrected": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corrected"
          },
          "hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hint"
          }
        },
        "type": "object",
        "required": [
          "query",
          "results"
        ],
        "title": "SearchResponse"
      },
      "SearchResult": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "n_papers": {
            "type": "integer",
            "title": "N Papers"
          },
          "first_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Year"
          },
          "last_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Year"
          },
          "venues": {
            "items": {
              "$ref": "#/components/schemas/VenueCount"
            },
            "type": "array",
            "title": "Venues"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "n_papers",
          "first_year",
          "last_year",
          "venues"
        ],
        "title": "SearchResult"
      },
      "SourcePaper": {
        "properties": {
          "ref": {
            "type": "string",
            "title": "Ref"
          },
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "key": {
            "type": "string",
            "title": "Key"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "venue": {
            "type": "string",
            "title": "Venue"
          },
          "type": {
            "type": "string",
            "enum": [
              "article",
              "inproceedings"
            ],
            "title": "Type"
          },
          "authors": {
            "items": {
              "$ref": "#/components/schemas/AuthorRef"
            },
            "type": "array",
            "title": "Authors"
          },
          "n_authors": {
            "type": "integer",
            "title": "N Authors"
          }
        },
        "type": "object",
        "required": [
          "ref",
          "id",
          "key",
          "title",
          "year",
          "venue",
          "type",
          "authors",
          "n_authors"
        ],
        "title": "SourcePaper"
      },
      "Status": {
        "properties": {
          "ready": {
            "type": "boolean",
            "title": "Ready"
          },
          "authors": {
            "type": "integer",
            "title": "Authors"
          },
          "papers": {
            "type": "integer",
            "title": "Papers"
          }
        },
        "type": "object",
        "required": [
          "ready",
          "authors",
          "papers"
        ],
        "title": "Status"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VenueCount": {
        "properties": {
          "venue": {
            "type": "string",
            "title": "Venue"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "venue",
          "count"
        ],
        "title": "VenueCount"
      }
    }
  }
}
