# Raw + derived data (multi-GB, regenerate via pipeline/parse_dblp.py / analysis/filter_after_2018.py)
data/raw/dblp.xml.gz
data/processed/*.csv
data/processed/*.sqlite*
data/processed/title_vectors/
data/processed/eval_results.json

# matplotlib/seaborn chart output (regenerate via analysis/visualize_dblp*.py / analyze_*.py)
analysis/charts/*.png

# React app: dependencies and build output (regenerate with npm install / npm run build)
frontend/node_modules/
frontend/dist/

# Python virtual environment
venv/

# Local secrets: LLM provider API keys (template: backend/.env.example)
backend/.env

# Local logs and caches
*.log
__pycache__/
*.pyc
