# Copy to backend/.env (gitignored) and fill in at least one provider.
# All of these have free tiers; none needs a credit card for basic use.
# Only providers with a key set (or a running Ollama) appear in the app.

# Which provider to use when the request doesn't pick one.
LLM_PROVIDER=groq

# https://console.groq.com/keys
GROQ_API_KEY=
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://openrouter.ai/keys  (use a model id ending in :free)
OPENROUTER_API_KEY=

# Override a provider's default model. Normally not needed: the app reads each provider's
# live model list and skips names it no longer serves.
# GROQ_MODEL=openai/gpt-oss-120b
# MISTRAL_MODEL=ministral-14b-latest
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OLLAMA_MODEL=qwen2.5:7b

# Local models: install Ollama, `ollama pull qwen2.5:7b` (needs tool-calling support).
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Any other OpenAI-compatible server (LM Studio, vLLM, Cerebras, Together, ...):
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=
# LLM_MODEL=
